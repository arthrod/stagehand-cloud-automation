# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="AI Web Scraper"
VERSION="1.0.0"
ENVIRONMENT=development
# Options: development, production
DEBUG=True
# Options: True, False
VERBOSE=2

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:8501"

# =============================================================================
# BROWSERBASE CONFIGURATION (Required for STAGEHAND_ENV=BROWSERBASE)
# =============================================================================
# Get your API key and project ID from https://www.browserbase.com
STAGEHAND_ENV=BROWSERBASE
# Options: BROWSERBASE or LOCAL
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# =============================================================================
# LOCAL BROWSER CONFIGURATION (Mac Support)
# =============================================================================
# Set STAGEHAND_ENV=LOCAL to use local browsers instead of Browserbase
# Set the Stagehand environment. Choose one:
#   - BROWSERBASE (cloud)
#   - LOCAL (run on your machine)
# NOTE: Intentionally left blank to avoid accidental cloud usage.
# STAGEHAND_ENV=BROWSERBASE
# STAGEHAND_ENV=LOCAL

# Browser Type - Select which browser to use on Mac
BROWSER_TYPE=chrome
# Options: chrome, arc, zen, firefox, vivaldi

# Browser Executable Path (optional - auto-detected if not set)
# Chrome: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Arc: /Applications/Arc.app/Contents/MacOS/Arc
# Zen: /Applications/Zen Browser.app/Contents/MacOS/zen
# Firefox: /Applications/Firefox.app/Contents/MacOS/firefox
# Vivaldi: /Applications/Vivaldi.app/Contents/MacOS/Vivaldi
BROWSER_EXECUTABLE_PATH=

# Attach to Existing Browser Session
USE_EXISTING_SESSION=false
# When true, connects to running browser instead of launching new one
# Requires browser to be started with --remote-debugging-port flag

# Chrome DevTools Protocol URL
BROWSER_CDP_URL=http://localhost:9222
# Used when USE_EXISTING_SESSION=true
# Default port is 9222, but can be different based on your setup

# Stagehand Settings
DOM_SETTLE_TIMEOUT_MS=30000
SELF_HEAL=true
HEADLESS=true
# Note: HEADLESS is ignored when USE_EXISTING_SESSION=true

# =============================================================================
# JOB PROCESSING
# =============================================================================
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=15

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# AI MODEL CONFIGURATION (Required)
# =============================================================================
# Get your API key from https://openrouter.ai
MODEL_API_KEY=
MODEL_NAME=google/gemini-2.5-flash
MODEL_BASE_URL=
