[run]
omit =
    tests/*
    */__pycache__/*
    */site-packages/*
    */.venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    except Exception as e:
    except ValueError as ve:
    logger.error
    logger.warning
    logger.info
    from stagehand import
    import stagehand
